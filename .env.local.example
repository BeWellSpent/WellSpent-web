# Copy this file to .env.local and fill in values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Feature flags (set to "true" to enable)
NEXT_PUBLIC_FEATURE_GOOGLE_AUTH=false

# Cloudflare Turnstile (Register form's captcha). Cloudflare's official
# always-pass test key — safe for local dev, never touches the real widget.
# The real site key (tied to bewellspent.com) is prod-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
