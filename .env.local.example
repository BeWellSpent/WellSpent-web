# Copy this file to .env.local and fill in values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# New C#/.NET backend (issue #78 rewrite). Only reachable when run locally via
# `dotnet run --project src/WellSpent.Api` in WellSpent-backend/dotnet — there
# is no deployed instance yet. Only used when NEXT_PUBLIC_FEATURE_CSHARP_AUTH=true.
NEXT_PUBLIC_CSHARP_API_URL=http://localhost:5021

# Feature flags (set to "true" to enable)
NEXT_PUBLIC_FEATURE_GOOGLE_AUTH=false
# Routes the Auth domain (login/register/verify-email/Google OAuth) through
# the new C# backend instead of the Go one. Requires the C# API running
# locally (see NEXT_PUBLIC_CSHARP_API_URL above) — leave off otherwise.
NEXT_PUBLIC_FEATURE_CSHARP_AUTH=false
# Same, for the status banner and changelog reads.
NEXT_PUBLIC_FEATURE_CSHARP_STATUS_CHANGELOG=false
# Same, for the User domain (profile, email change, account deletion).
NEXT_PUBLIC_FEATURE_CSHARP_USER=false
# Same, for the Notification domain (bell, alert subscriptions).
NEXT_PUBLIC_FEATURE_CSHARP_NOTIFICATION=false
# Same, for the Invite domain (send/accept/cancel budget invites).
NEXT_PUBLIC_FEATURE_CSHARP_INVITE=false

# Cloudflare Turnstile (Register form's captcha). Cloudflare's official
# always-pass test key — safe for local dev, never touches the real widget.
# The real site key (tied to bewellspent.com) is prod-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
